@startuml
!theme C4_brown from <C4/themes>
!include <C4/C4_Container>

Person(client, "Клиент", "Клиент банка")
Person(employee, "Сотрудник", "Сотрудник банка")
Person(call_manager, "Менеджер колл центра", "Менеджер по работе с клиентами")
Person(partner_call_manager, "Менеджер партнерского колл центра", "Менеджер по работе с клиентами")


System_Boundary(standart_bank, "Standart Bank") {
    Container(abs_client, "АБС клиент", "Delphi", "Десктопный клиент для работы сотрудников отделений")
    ContainerDb(abs_db, "АБС БД", "Oracle", "База данных с основной информацией по счетам и бухгалтерией")

    Container(call_center_front, "ВЭБ клиент колл-центра", "React.js", "Вэб интерфейс для операторов колл-центра")
    Container(call_center_back, "Бэкенд колл-центра", "Java Spring Boot + PostgreSQL", "Бэкенд системы колл-центра")
    ' ContainerDb(call_center_db, "БД колл-центра", "PostgreSQL", "База данных системы колл-центра")

    Container(deposits_service, "Сервис с данными о депозитах", "Python, Flask","Хранит инфо о доступных депозитах")
    ContainerDb(deposits_service_db, "База данных сервиса депозитов", "PostgreSQL")
    Container(deposits_service_cron, "Регулярный процесс", "Python", "В нерабочее время собирает обновления о депзитах из АБС")
    Container(deposits_service_cron_files, "Регулярный процесс", "Python", "Регулярно формирует файл с депозитами для партнерского колл центра")
}

System_Ext(call_center_partner, "Партнерской колл центр", "Система партнерского колл центра")
Rel(partner_call_manager, call_center_partner, "Получает заявки")
Rel_U(partner_call_manager, client, "Связывается с клиентом")


Rel(deposits_service, deposits_service_db, "SQL")
Rel(deposits_service_cron, deposits_service_db, "SQL")
Rel(deposits_service_cron, abs_db, "SQL")
Rel(deposits_service_cron_files, deposits_service_db, "SQL")
Rel(deposits_service_cron_files, call_center_partner, "SFTP, отправляет файл с депозитами")

Rel_U(abs_client, abs_db, "Работает с базой данных")


Rel(call_center_front, call_center_back, "HTTP")
' Rel(call_center_back, call_center_db, "SQL")
Rel(call_center_back, call_center_partner, "HTTP, Передает часть заявок на аутсорс")
Rel(call_center_back, deposits_service, "HTTP, получает данные о депозитах")

Rel(call_manager, call_center_front, "Получает заявку на депозит")
Rel_U(call_manager, client, "Связывается по поводу вклада")

Rel_U(employee, abs_client, "Редактирует/просматривает ставки")

@enduml